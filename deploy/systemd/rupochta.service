[Unit]
Description=RuPochta webmail (рупочта.рф)
Documentation=https://github.com/lmcorp-it/RuPochta
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=rupochta
Group=rupochta
WorkingDirectory=/opt/rupochta
EnvironmentFile=/etc/rupochta/rupochta.env
ExecStart=/opt/rupochta/.venv/bin/python -m uvicorn rupochta_server:app \
    --host 127.0.0.1 --port 18400 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

# The service only ever needs its own state directory and the docker socket
# (mailbox provisioning shells into the mail container).
StateDirectory=rupochta
ReadWritePaths=/var/lib/rupochta
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
