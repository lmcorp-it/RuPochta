# Окружение веб-интерфейса RuПочты. bootstrap.sh кладёт заполненную копию в
# /etc/rupochta/rupochta.env (владелец root, права 0640, группа rupochta).
#
# Секреты генерируются при установке; здесь — плейсхолдеры __...__.

# --- почтовый контур -------------------------------------------------------
MAIL_DOMAIN=__MAIL_DOMAIN__
# Ходим в IMAP/SMTP по собственному FQDN: bootstrap.sh добавляет его в
# /etc/hosts как 127.0.0.1, поэтому трафик не выходит наружу, а имя совпадает
# с сертификатом — проверку TLS отключать не нужно.
MAIL_HOST=__MAIL_FQDN__
MAIL_IMAP_HOST=__MAIL_FQDN__
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=__MAIL_FQDN__
MAIL_SMTP_PORT=587
MAIL_SMTP_VERIFY_TLS=1

# Что показывать пользователям в настройках почтовых клиентов.
MAIL_PUBLIC_HOST=__MAIL_FQDN__
MAIL_PUBLIC_IMAP_PORT=993
MAIL_PUBLIC_SMTP_PORT=587
MAIL_WEBMAIL_URL=https://__MAIL_FQDN__
MAILADMIN_SSO_PUBLIC_URL=https://__MAIL_FQDN__

# --- локальное управление ящиками -----------------------------------------
# Админ-панель заводит ящики через `docker exec mailserver`, поэтому сервис
# должен состоять в группе docker (см. systemd/rupochta.service).
WEBMAIL_LOCAL_MAILSERVER=1
MAILSERVER_CONTAINER=mailserver
MAILSERVER_ACCOUNTS_FILE=/srv/mail/mail-server/config/postfix-accounts.cf
MAILSERVER_ACCOUNT_LOCK_PATH=/var/lib/rupochta/mail-accounts.lock

# --- секреты и состояние ---------------------------------------------------
WEBMAIL_SECRET_KEY=__WEBMAIL_SECRET_KEY__
MAIL_ADMIN_KEY=__MAIL_ADMIN_KEY__
WEBMAIL_DB=/var/lib/rupochta/webmail_aliases.db

# --- необязательные интеграции --------------------------------------------
# Незаданные интеграции просто выключены.
#MAIL_SSO_ISSUER=
#MAIL_SSO_CLIENT_ID=
#MAIL_SSO_CLIENT_SECRET=
# Только ldaps://: сертификат проверяется по цепочке, имени и сроку,
# незашифрованный ldap:// игнорируется (через это соединение идёт пароль).
#MAILADMIN_LDAPS_URLS=ldaps://dc1.corp.local
#MAILADMIN_LDAPS_BASE_DN=
# Доменного CA обычно нет в системном наборе — укажите его файл:
#MAILADMIN_LDAPS_CA_FILE=/etc/rupochta/ad-ca.pem
#MAILADMIN_LDAPS_BIND_USER=
#LDAP_BIND_PASS=
