# Настройки docker-mailserver. Копируется bootstrap.sh в
# /srv/mail/mail-server/mailserver.env, плейсхолдеры подставляются автоматически.
# Полный список переменных: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/

# --- базовое ---------------------------------------------------------------
OVERRIDE_HOSTNAME=__MAIL_FQDN__
POSTMASTER_ADDRESS=postmaster@__MAIL_DOMAIN__
LOG_LEVEL=info
TZ=__TZ__

# Сертификаты берутся из /etc/letsencrypt, смонтированного с хоста.
SSL_TYPE=letsencrypt

# Ящики создаются только через админ-панель RuПочты (postfix-accounts.cf),
# LDAP-бэкенд DMS не используется.
ACCOUNT_PROVISIONER=FILE

# --- приём и отправка ------------------------------------------------------
# Никаким сетям Docker не доверяем как «своим» — релей только с аутентификацией.
PERMIT_DOCKER=none
# Запрет отправки от чужого адреса: логин обязан совпадать с From.
SPOOF_PROTECTION=1
# Лимит на письмо — 50 МиБ, квота на ящик не ограничена.
POSTFIX_MESSAGE_SIZE_LIMIT=52428800
POSTFIX_MAILBOX_SIZE_LIMIT=0
# POP3 не нужен: веб-интерфейс и клиенты ходят по IMAP.
ENABLE_POP3=0
# ManageSieve наружу не публикуется (порт 4190 не проброшен).
ENABLE_MANAGESIEVE=0

# --- антиспам и антивирус --------------------------------------------------
# Rspamd заменяет связку Amavis + SpamAssassin + OpenDKIM + OpenDMARC + policyd-spf,
# поэтому все они выключены (иначе проверки задвоятся).
ENABLE_RSPAMD=1
ENABLE_RSPAMD_REDIS=1
RSPAMD_GREYLISTING=1
RSPAMD_LEARN=1
MOVE_SPAM_TO_JUNK=1
MARK_SPAM_AS_READ=0
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
# ClamAV требует ~1.5 ГиБ RAM сверх остального. Выключите (0), если VM тесная.
ENABLE_CLAMAV=1

# --- защита ----------------------------------------------------------------
ENABLE_FAIL2BAN=1
POSTSCREEN_ACTION=enforce
ENABLE_UPDATE_CHECK=1
UPDATE_CHECK_INTERVAL=1d

# --- отправка через внешний релей (если провайдер блокирует 25/tcp) --------
# Раскомментируйте и заполните, тогда исходящая почта пойдёт через smarthost.
#RELAY_HOST=smtp.provider.example
#RELAY_PORT=587
#RELAY_USER=
#RELAY_PASSWORD=
