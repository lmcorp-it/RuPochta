# Configuration for the public рупочта.рф service.
#
# Copy to /etc/rupochta/rupochta.env on the mail host, fill in the secrets, and
# keep it at mode 0600 — it holds the session key and the admin API key.
#
# The domain is written in punycode everywhere a machine reads it:
#   рупочта.рф  ==  xn--80a1acdmd4a.xn--p1ai
# Postfix, Dovecot, nginx and certbot all want the punycode form.

# --- identity -------------------------------------------------------------
MAIL_DOMAIN=xn--80a1acdmd4a.xn--p1ai
MAIL_HOST=127.0.0.1
MAIL_IMAP_PORT=993
MAIL_SMTP_PORT=587
MAIL_PUBLIC_HOST=mail.xn--80a1acdmd4a.xn--p1ai
MAIL_WEBMAIL_URL=https://xn--80a1acdmd4a.xn--p1ai
MAIL_SSO_PUBLIC_URL=https://xn--80a1acdmd4a.xn--p1ai

# --- secrets (generate, do not reuse the examples) ------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WEBMAIL_SECRET_KEY=
MAIL_ADMIN_KEY=

# --- state ----------------------------------------------------------------
WEBMAIL_DB=/var/lib/rupochta/webmail_aliases.db

# --- local mail server ----------------------------------------------------
# The public service provisions mailboxes itself, which needs the local
# docker-mailserver path rather than an external control plane.
WEBMAIL_LOCAL_MAILSERVER=1
MAILSERVER_CONTAINER=mailserver
MAILSERVER_ACCOUNTS_FILE=/srv/mail/mail-server/config/postfix-accounts.cf

# --- public registration --------------------------------------------------
# This is what makes рупочта.рф an open service. Leave it unset anywhere else.
MAIL_PUBLIC_SIGNUP=1
MAIL_PUBLIC_SIGNUP_DOMAIN=xn--80a1acdmd4a.xn--p1ai
MAIL_PUBLIC_SIGNUP_MIN_PASSWORD=10
MAIL_PUBLIC_SIGNUP_PER_HOUR=3
MAIL_PUBLIC_SIGNUP_TERMS_URL=

# --- transport safety -----------------------------------------------------
# Certificates are real on this host, so certificate verification stays on.
MAIL_SMTP_VERIFY_TLS=1

# --- optional integrations (leave empty to keep them off) -----------------
MAIL_SSO_ISSUER=
MAIL_SSO_CLIENT_ID=
MAIL_SSO_CLIENT_SECRET=
MAIL_TICKET_INTAKE_URL=
RUPOCHTA_INTERNAL_TOKEN=
PROXY_PANEL_URL=
