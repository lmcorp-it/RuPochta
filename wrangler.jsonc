{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rupochta-site",
  "compatibility_date": "2026-08-01",

  // Статика без кода воркера: Cloudflare отдаёт файлы из docs/ со своего
  // ассет-хранилища, запросы не тарифицируются как вызовы Worker.
  "assets": {
    "directory": "./docs",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // Сайт живёт на своём домене; *.workers.dev не публикуем.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "rupochta.tech", "custom_domain": true },
    { "pattern": "www.rupochta.tech", "custom_domain": true }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
