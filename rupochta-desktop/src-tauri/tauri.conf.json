{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RuPochta",
  "version": "0.2.0",
  "identifier": "ru.rupochta.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "RuPochta — вход и регистрация",
        "width": 1280,
        "height": 860,
        "minWidth": 390,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Russian"],
        "installMode": "currentUser"
      }
    }
  }
}
