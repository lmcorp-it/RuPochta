{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Calm editorial mail workspace built from ink, cobalt, paper and precise routing cues.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.114,
          0.271
        ],
        "hex": "#0b1d45"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.122,
          0.4,
          0.898
        ],
        "hex": "#1f66e5"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.941,
          0.267,
          0.325
        ],
        "hex": "#f04453"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "canvas": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.957,
          0.973,
          1
        ],
        "hex": "#f4f8ff"
      }
    },
    "blueprint": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.918,
          0.945,
          1
        ],
        "hex": "#eaf1ff"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.796,
          0.863,
          0.961
        ],
        "hex": "#cbdcf5"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.357,
          0.42,
          0.525
        ],
        "hex": "#5b6b86"
      }
    },
    "cyan": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.208,
          0.722,
          0.91
        ],
        "hex": "#35b8e8"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.075,
          0.482,
          0.349
        ],
        "hex": "#137b59"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 7,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 28,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Arial Narrow",
        "fontSize": {
          "value": 4,
          "unit": "rem"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.16,
          "unit": "rem"
        },
        "lineHeight": 0.94
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Arial Narrow",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.06,
          "unit": "rem"
        },
        "lineHeight": 1
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "rem"
        },
        "lineHeight": 1.55
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 750,
        "letterSpacing": {
          "value": 0,
          "unit": "rem"
        },
        "lineHeight": 1.35
      }
    },
    "utility": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-monospace",
        "fontSize": {
          "value": 0.625,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.05,
          "unit": "rem"
        },
        "lineHeight": 1.4
      }
    }
  }
}
