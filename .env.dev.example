# Пример окружения для локального dev-стенда (docker-compose.dev.yml).
# Скопируйте в .env.dev и при желании измените. Значения ниже — только для
# разработки на своей машине, в продакшене НЕ ИСПОЛЬЗОВАТЬ.
#
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up --build

# Домен, для которого заведены ящики в Greenmail (см. GREENMAIL_OPTS).
MAIL_DOMAIN=example.local

# Подпись сессионных куки. Для локальной разработки достаточно любой строки
# длиной от 32 символов; в продакшене генерируется, например, через
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
WEBMAIL_SECRET_KEY=dev-secret-do-not-use-in-prod-xxxxxxxxxxxxxxxx

# Ключ админского API (заголовок X-Admin-Key при обращениях к /admin/api).
MAIL_ADMIN_KEY=dev-admin-key
